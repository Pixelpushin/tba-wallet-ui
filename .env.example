# Copy this file to .env.local and fill in the values for your own
# ERC-6551-enabled NFT collection. See README.md for a full explanation of
# each variable.

# --- Required ---

# The NFT collection contract address this UI is gated to (an ERC-721).
NEXT_PUBLIC_TOKEN_CONTRACT=0x0000000000000000000000000000000000000000

# JSON-RPC URL for the chain that collection lives on.
NEXT_PUBLIC_RPC_URL=https://ethereum-rpc.publicnode.com

# Numeric chain ID (decimal) for the chain above, e.g. 1 for Ethereum
# mainnet, 8453 for Base, 137 for Polygon.
NEXT_PUBLIC_CHAIN_ID=1

# A free WalletConnect / Reown Cloud project ID (https://cloud.reown.com) -
# powers the wallet connect modal (injected extensions + WalletConnect/QR).
NEXT_PUBLIC_REOWN_PROJECT_ID=

# --- Optional ---

# Human-readable chain name shown in the UI. Defaults to "Chain <id>".
NEXT_PUBLIC_CHAIN_NAME=Ethereum

# Block explorer base URL used for "view transaction" / address links.
# Defaults to https://etherscan.io.
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://etherscan.io

# Alchemy API key. Without this, the demo page still works for ETH
# activate/send, but ERC-20 and NFT balances won't be listed (the panel has
# nothing to enumerate). With it, /wallet/[tokenId] fetches full holdings
# via Alchemy's NFT + token APIs. Server-side only, never exposed to the
# client.
ALCHEMY_API_KEY=

# RPC URL used for Ethereum-mainnet ENS name resolution in the recipient
# field. Defaults to a public mainnet RPC if unset. Only relevant if your
# collection itself is not already on Ethereum mainnet.
ENS_RPC_URL=https://ethereum-rpc.publicnode.com
